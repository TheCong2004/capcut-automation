# ArtCraft Pipeline Configuration Template

APP_HOST=127.0.0.1
UNIFIED_SERVER_PORT=30000

# CapCut Mate Settings
CAPCUT_MATE_BASE_URL=http://127.0.0.1:30000
CAPCUT_OUTPUT_DIR=

# LLM Script Generation Settings
LLM_BASE_URL=http://127.0.0.1:20128
LLM_API_KEY=sk-omniroute-local
LLM_MODEL=auto

# OmniRoute gateway adapter (backend only; never expose the endpoint key to Vite)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_ENDPOINT_KEY=

# Optional service health contracts
PLAYWRIGHT_BASE_URL=http://127.0.0.1:9223
TTS_BASE_URL=

# Performance & Timeouts
REQUEST_TIMEOUT_SECONDS=120
PIPELINE_MAX_RETRIES=3
PIPELINE_POLL_INTERVAL_MS=2000
PIPELINE_JOB_TIMEOUT_SECONDS=600

# Logging & Observability
LOG_LEVEL=info
